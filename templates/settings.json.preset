{
  "$comment": "Starter project .claude/settings.json — trim to taste.",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      { "matcher": "Bash", "hooks": [ { "type": "command", "command": "$CLAUDE_PROJECT_DIR/hooks/guard-dangerous.sh" } ] }
    ]
  },
  "$comment2": "The hook above only fires after you copy hooks/guard-dangerous.sh into <project>/.claude/hooks/ and adjust the path — the preset does not ship the script. See hooks/README.md for platform notes (POSIX bash; Windows needs Git Bash on PATH)."
}
